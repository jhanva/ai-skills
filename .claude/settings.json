{
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git rev-parse:*)",
      "Bash(ls:*)"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(rm -fr:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -f:*)",
      "Bash(git clean -d:*)",
      "Bash(sudo:*)",
      "Bash(chmod 777:*)",
      "Bash(chmod -R 777:*)",
      "Read(**/.env*)",
      "Write(**/.env)",
      "Edit(**/.env)"
    ]
  },
  "extraKnownMarketplaces": {
    "ai-skills": {
      "source": {
        "source": "github",
        "repo": "jhanva/ai-skills"
      }
    }
  },
  "enabledPlugins": {
    "core@ai-skills": true,
    "android@ai-skills": true,
    "image@ai-skills": true,
    "design@ai-skills": true,
    "repo-ops@ai-skills": true
  }
}
